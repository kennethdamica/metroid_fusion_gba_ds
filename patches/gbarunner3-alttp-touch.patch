--- a/code/core/arm7/source/IpcServices/SystemIpcService.cpp
+++ b/code/core/arm7/source/IpcServices/SystemIpcService.cpp
@@ -1,20 +1,60 @@
 #include "common.h"
 #include <libtwl/spi/spiPmic.h>
 #include "SystemIpcService.h"
+#include <libtwl/rtos/rtosIrq.h>
+#include <libtwl/rtos/rtosMutex.h>
+#include <nds/arm7/touch.h>
+
+static volatile u32* sTouch;
+static u32 sSequence;
+static rtos_mutex_t sTouchMutex;
+
+void zeldaInitializeTouchMutex() { rtos_createMutex(&sTouchMutex); }
+
+void zeldaUpdateTouch()
+{
+    if (!sTouch) return;
+    // Serialize SPI users while allowing the sound timer/thread to preempt.
+    rtos_lockMutex(&sTouchMutex);
+    touchPosition pos = {};
+    bool down=touchPenDown();
+    if (down) touchReadXY(&pos);
+    down=down && pos.rawx && pos.rawy && pos.px<256 && pos.py<192;
+    u32 packet=((++sSequence & 0x7FFF)<<17) | (down?0x10000:0) | (pos.py<<8) | pos.px;
+    *sTouch=packet;
+    rtos_unlockMutex(&sTouchMutex);
+}
 
 void SystemIpcService::HandleMessage(u32 data)
 {
     switch (data & 0xF)
     {
+        case SYSTEM_IPC_CMD_SET_TOUCH_BUFFER:
+        {
+            u32 address=(data >> 4) << 5;
+            if (address>=0x02040000 && address<0x02200000)
+            {
+                u32 irq=rtos_disableIrqs();
+                sTouch=(volatile u32*)address;
+                *sTouch=0;
+                rtos_restoreIrqs(irq);
+            }
+            SendResponseMessage(0);
+            break;
+        }
         case SYSTEM_IPC_CMD_SET_TOP_BACKLIGHT:
         {
+            rtos_lockMutex(&sTouchMutex);
             pmic_setTopBacklightEnable((data >> 4) & 1);
+            rtos_unlockMutex(&sTouchMutex);
             SendResponseMessage(0);
             break;
         }
         case SYSTEM_IPC_CMD_SET_BOTTOM_BACKLIGHT:
         {
+            rtos_lockMutex(&sTouchMutex);
             pmic_setBottomBacklightEnable((data >> 4) & 1);
+            rtos_unlockMutex(&sTouchMutex);
             SendResponseMessage(0);
             break;
         }
