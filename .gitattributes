* text=auto
*.py text eol=lf
*.sh text eol=lf
*.command text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.cpp text eol=lf
*.c text eol=lf
*.h text eol=lf
*.s text eol=lf
*.inc text eol=lf
# Unified-diff context lines carry required leading spaces, including blank lines.
*.patch text eol=lf whitespace=-blank-at-eol,-space-before-tab
Makefile text eol=lf
*.txt text eol=lf
